# config.yaml.example — fully annotated example for symphony-linear.
# Copy this to your workspace directory as config.yaml and adjust to taste.
#
# Exactly one of `linear` or `github` must be configured.  Comment out or
# remove the block you are not using.

linear:
  # REQUIRED. Linear Personal API key.
  # Use ${LINEAR_API_KEY} to read from the environment (or set LINEAR_API_KEY
  # env var — the daemon falls back to it if this field is missing or empty).
  # The key can belong to your own account or a dedicated bot account.
  api_key: ${LINEAR_API_KEY}

  # Name of the label that triggers the bot (default: Agent).
  trigger_label: Agent

  # Linear workflow state set while the AI is working (default: In Progress).
  in_progress_state: In Progress

  # Linear workflow state set while waiting for human reply (default: Needs Input).
  needs_input_state: Needs Input

  # Optional. Linear workflow state that enables manual QA. When a ticket
  # enters this state, the daemon runs the repo's .symphony/serve script
  # inside the sandbox. Only one serve runs globally; moving a different
  # ticket into this state bumps the previous one back to needs_input_state.
  # Omit to disable the feature entirely.
  # qa_state: QA


# ---------------------------------------------------------------------------
# GitHub Projects v2 backend (comment out the `linear:` block above and
# uncomment this block to use GitHub instead).
# ---------------------------------------------------------------------------

# github:
#   # REQUIRED. GitHub personal-access token or installation token.
#   # Classic PAT needs `repo` + `project` scopes (read+write).
#   # Fine-grained PATs need read/write on Issues + Projects + read on Contents.
#   # Use ${GITHUB_TOKEN} to read from the environment (or set GITHUB_TOKEN
#   # env var — the daemon falls back to it if this field is missing or empty).
#   token: ${GITHUB_TOKEN}
#
#   # REQUIRED. GitHub project reference.
#   # Format: orgs/<org>/projects/<number> or users/<user>/projects/<number>.
#   project: orgs/my-org/projects/1
#   # Alternative: users/my-user/projects/2
#
#   # Name of the single-select field that triggers the bot (default: Symphony).
#   trigger_field: Symphony
#
#   # Name of the single-select Status field on the project (default: Status).
#   status_field: Status
#
#   # Status option name for in-progress work (default: In Progress).
#   # Missing options on the Status field are created automatically at startup.
#   in_progress_status: In Progress
#
#   # Status option name when input is needed from a human (default: Needs Input).
#   needs_input_status: Needs Input
#
#   # Optional. Status option name that enables manual QA. When a ticket
#   # enters this status, the daemon runs the repo's .symphony/serve script
#   # inside the sandbox. Only one serve runs globally; moving a different
#   # ticket into this status bumps the previous one back to needs_input_status.
#   # Omit to disable the feature entirely.
#   # qa_status: QA
#
#   # Protocol used to clone repositories (default: ssh). Set to https if
#   # your organization enforces MFA on SSH. HTTPS requires the operator
#   # to have git credentials set up on the host (e.g. via `gh auth login`
#   # or a credential helper) since git ops run outside the sandbox under
#   # the daemon user's identity.
#   # clone_protocol: ssh

# ---------------------------------------------------------------------------
# Coding agent
# ---------------------------------------------------------------------------

# Which coding-agent CLI the daemon launches (default: opencode).
# One of `opencode`, `omp`, or `pi`.  Global for the whole daemon — there is
# no per-project or per-issue override.  The binary must be on the sandbox
# PATH (see SYMPHONY_SANDBOX_PATH); the daemon refuses to start otherwise.
# Agents do not share sessions: changing this value makes a ticket holding a
# session from the other agent start a fresh session on its next turn, losing
# that ticket's conversation history.
agent: opencode

# Optional. Per-issue model overrides for the primary agent.  A
# `Model: <value>` label on an issue runs that issue's turns with
# `--model <resolved>` passed to the selected agent, first turn and
# resumes alike.  The
# value is looked up case-insensitively here; a value that is not in the
# map is used verbatim, so a raw provider/model id (e.g.
# `Model: anthropic/claude-sonnet-4-6`) works with no config change.
# Every value below must be a full `provider/model` id — the daemon
# refuses to start otherwise.
# Remove the label and the agent's own model applies again.  Subagents
# keep their own models.  On Linear, one label per alias is created at
# startup; on GitHub, labels are per-repository, so create them yourself.
# models:
#   Strong: anthropic/claude-opus-5
#   Cheap: openai/gpt-5-mini

sandbox:
  # Paths to conceal inside the sandbox (defaults shown below).
  # Directories are overlaid with an empty tmpfs; files and sockets are
  # replaced with /dev/null.  ~ and symlinks are expanded.
  hide_paths:
    - ~/.ssh
    - ~/.gnupg
    - ~/.aws
    - ~/.config/gcloud
    - ~/.netrc
    - ~/.docker
    - /run/docker.sock

  # Additional host paths to bind read-write inside the sandbox.
  # These use --bind (not --bind-try), so missing paths cause a fatal error.
  # Applied before hide_paths, so hide still wins on collision.
  # WARNING: Listed paths bypass the read-only host root mount.
  # extra_rw_paths:
  #   - ~/projects/shared-tools

  # Map a path inside the sandbox to a host directory (key = sandbox path,
  # value = host source).  Relative values resolve under the ticket's
  # mounts/ directory and are deleted with the ticket; absolute values are
  # shared host directories that survive ticket cleanup.  Both sides are
  # created on the host.  Binds apply after hide_paths, so an explicit
  # mapping can punch through a broad hide.
  # CAUTION: a shared absolute directory is writable by up to 5 concurrent
  # ticket workers — not every tool tolerates that.
  # dir_map:
  #   ~/.config/npm: npm
  #   ~/.npm: ~/sandboxes/caches/.npm


# ---------------------------------------------------------------------------
# Optional webhook server (Linear only, no GitHub support).
# Uncomment to enable a lightweight HTTP server that listens for Linear
# webhook events so the daemon can react to ticket updates immediately
# instead of waiting for the next poll cycle.
# ---------------------------------------------------------------------------
# webhook:
#   # REQUIRED when the webhook block is present. Port for the webhook server.
#   port: 4000
#
#   # REQUIRED when the webhook block is present. Linear webhook secret to
#   # verify incoming HMAC signatures.  Use ${SYMPHONY_LINEAR_WEBHOOK_SECRET}
#   # to read from the environment (or set SYMPHONY_LINEAR_WEBHOOK_SECRET
#   # env var — the daemon falls back to it if this field is missing or empty).
#   linear_secret: ${SYMPHONY_LINEAR_WEBHOOK_SECRET}

# Seconds between tracker poll cycles (default: 30, minimum: 1).
poll_interval_seconds: 30

# Max seconds per AI turn before the process is killed (default: 1800).
turn_timeout_seconds: 1800

# Max seconds an AI turn may go without producing output on stdout or stderr
# before the process is killed (default: 1200). This is the idle watchdog:
# a stalled turn is killed long before the absolute cap above, and the
# failure comment distinguishes the two modes. Global only — there is no
# per-project override.
turn_idle_timeout_seconds: 1200

# Whether to switch the workspace to a per-ticket branch (default: true).
# When true, prepare() switches to the tracker's suggested branch name
# (where available), or symphony/<id> as a fallback (creating it if needed).
# When false, prepare() skips the branch switch entirely and the agent
# works on whatever branch git clone checked out (i.e. the remote default
# branch). Useful when you've arranged for the agent to commit directly to
# the default branch — pushing, credentials, and PR creation remain outside
# Symphony's scope either way.
# auto_branch: true
